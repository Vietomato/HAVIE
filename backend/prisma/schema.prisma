datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
  REFUND_PENDING
}

enum PaymentMethod {
  COD
  MOCK_QR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum AdvisorNoteStatus {
  DRAFT
  APPROVED
  REJECTED
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  fullName          String
  phone             String?
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  emailVerifiedAt   DateTime?
  deactivatedReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart?
  auditLogs AuditLog[]
  advisorConversations AdvisorConversation[]

  @@map("users")
}

model EmailVerificationChallenge {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  phone        String?
  passwordHash String
  otpHash      String
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("email_verification_challenges")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String
  phone         String
  province      String
  district      String
  ward          String
  streetAddress String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ============================================================
// PRODUCT CATALOG
// ============================================================

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  description    String?
  categoryId     String
  brandId        String
  imageUrls      String[] @default([])
  ratingAverage  Float    @default(0)
  reviewCount    Int      @default(0)
  badge          String?
  specs          String[] @default([])

  // Cho phép chatbot chủ động đề xuất sau khi shop duyệt dữ liệu.
  advisorEnabled Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id])
  brand        Brand                @relation(fields: [brandId], references: [id])
  variants     ProductVariant[]
  reviews      Review[]
  advisorNotes ProductAdvisorNote[]

  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String   @unique
  name          String
  attributes    Json     @default("{}")
  price         Int
  oldPrice      Int?
  stockQuantity Int      @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  movements    StockMovement[]
  advisorNotes ProductAdvisorNote[]

  @@map("product_variants")
}

// ============================================================
// SHOP ADVISOR NOTES
// ============================================================

model ProductAdvisorNote {
  id           String            @id @default(uuid())

  // Sản phẩm được nhận xét.
  productId    String

  // Null: nhận xét chung cho sản phẩm.
  // Có giá trị: nhận xét dành riêng cho một biến thể.
  variantId    String?

  // Cảm nhận hoặc hướng tư vấn của shop.
  content      String

  // Cấu hình, bối cảnh thử và giới hạn áp dụng.
  conditions   Json              @default("{}")

  // Chỉ nhận xét APPROVED mới được chatbot sử dụng.
  reviewStatus AdvisorNoteStatus @default(DRAFT)
  reviewedAt   DateTime?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, reviewStatus])
  @@index([variantId])
  @@map("product_advisor_notes")
}

// ============================================================
// INVENTORY
// ============================================================

model StockMovement {
  id        String   @id @default(uuid())
  variantId String
  type      String // IN, OUT, ADJUSTMENT
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id              String        @id @default(uuid())
  orderCode       String        @unique
  userId          String
  status          OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Int
  shippingFee     Int           @default(0)
  totalAmount     Int
  recipientName   String
  recipientPhone  String
  shippingAddress String
  note            String?
  cancelReason    String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  variantId   String
  productName String
  variantName String
  price       Int
  quantity    Int
  subtotal    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ============================================================
// CUSTOMER REVIEWS
// ============================================================

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  orderId   String?
  rating    Int
  comment   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AdvisorConversation {
  id                  String   @id @default(uuid())
  userId              String
  title               String   @default("Cuộc trò chuyện mới")
  titleCustomized     Boolean  @default(false)
  needs               Json     @default("{}")
  lastQuestion        String?
  isProcessing        Boolean  @default(false)
  processingStartedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AdvisorMessage[]

  @@index([userId, updatedAt])
  @@map("advisor_conversations")
}

model AdvisorMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String   @db.Text
  candidates     Json?
  pricingNotice  String?
  action         String?
  createdAt      DateTime @default(now())

  conversation AdvisorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("advisor_messages")
}
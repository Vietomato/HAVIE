# Copy this template to .env and configure locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/havie_db?schema=public"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
CORS_ORIGIN=http://localhost:5174
APP_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Email: configure your own mailbox and app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=
SMTP_FROM=your-email@example.com
ADMIN_EMAIL_ALLOWLIST=

# Leave empty to use local uploads.
CLOUDINARY_URL=

# AI: set your own key for Groq, or select ollama.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen2.5:3b
ADVISOR_NATURAL_REPLIES=true
HAVIE_SEMANTIC_SEARCH=true
HAVIE_EMBEDDING_URL=http://127.0.0.1:11434
HAVIE_EMBEDDING_MODEL=bge-m3
CHAT_MAX_CONCURRENT=2

# QR checkout: values from your own payOS channel.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Google login stays disabled until all three values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/social/google/callback

# Optional shared session store. Empty uses PostgreSQL.
REDIS_URL=
PRISMA_POOL_LIMIT=10
# Set only for the actual trusted reverse-proxy chain in production.
# TRUST_PROXY_HOPS=1
